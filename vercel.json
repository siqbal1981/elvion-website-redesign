{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "elvion-website.vercel.app"
        }
      ],
      "destination": "https://www.elvionbulb.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/product/compatible-with-wa-style-devices/",
      "destination": "/shop.html",
      "statusCode": 301
    },
    {
      "source": "/product/compatible-with-wa-style-devices",
      "destination": "/shop.html",
      "statusCode": 301
    },
    {
      "source": "/about-us",
      "destination": "/about.html",
      "statusCode": 301
    },
    {
      "source": "/about-us/",
      "destination": "/about.html",
      "statusCode": 301
    },
    {
      "source": "/about",
      "destination": "/about.html",
      "statusCode": 301
    },
    {
      "source": "/about/",
      "destination": "/about.html",
      "statusCode": 301
    },
    {
      "source": "/contact-us",
      "destination": "/contact.html",
      "statusCode": 301
    },
    {
      "source": "/contact-us/",
      "destination": "/contact.html",
      "statusCode": 301
    },
    {
      "source": "/contact",
      "destination": "/contact.html",
      "statusCode": 301
    },
    {
      "source": "/contact/",
      "destination": "/contact.html",
      "statusCode": 301
    },
    {
      "source": "/shop",
      "destination": "/shop.html",
      "statusCode": 301
    },
    {
      "source": "/shop/",
      "destination": "/shop.html",
      "statusCode": 301
    },
    {
      "source": "/faq",
      "destination": "/faq.html",
      "statusCode": 301
    },
    {
      "source": "/faq/",
      "destination": "/faq.html",
      "statusCode": 301
    },
    {
      "source": "/guides",
      "destination": "/guides.html",
      "statusCode": 301
    },
    {
      "source": "/guides/",
      "destination": "/guides.html",
      "statusCode": 301
    },
    {
      "source": "/product/(.*)",
      "destination": "/shop.html",
      "statusCode": 301
    },
    {
      "source": "/product-category/(.*)",
      "destination": "/shop.html",
      "statusCode": 301
    },
    {
      "source": "/cart/",
      "destination": "/shop.html",
      "statusCode": 301
    },
    {
      "source": "/cart",
      "destination": "/shop.html",
      "statusCode": 301
    },
    {
      "source": "/checkout/",
      "destination": "/shop.html",
      "statusCode": 301
    },
    {
      "source": "/checkout",
      "destination": "/shop.html",
      "statusCode": 301
    },
    {
      "source": "/my-account/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/my-account",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/wp-content/:path*",
      "destination": "/__gone"
    },
    {
      "source": "/wp-includes/:path*",
      "destination": "/__gone"
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/__gone"
    },
    {
      "source": "/wp-json/:path*",
      "destination": "/__gone"
    },
    {
      "source": "/wp-login.php",
      "destination": "/__gone"
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/__gone"
    },
    {
      "source": "/feed",
      "destination": "/__gone"
    },
    {
      "source": "/feed/",
      "destination": "/__gone"
    },
    {
      "source": "/comments/feed",
      "destination": "/__gone"
    },
    {
      "source": "/comments/feed/",
      "destination": "/__gone"
    },
    {
      "source": "/:path*/feed",
      "destination": "/__gone"
    },
    {
      "source": "/:path*/feed/",
      "destination": "/__gone"
    }
  ]
}
